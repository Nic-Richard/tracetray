# Settings for docker-compose.production.yml. Never commit the filled-in copy.
# Hex passwords keep the connection string simple (openssl rand -hex 24).
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=

TRACETRAY_MODE=production
# Clerk and Stripe keys are required for the server to start.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Optional features. Empty keeps them off.
ANTHROPIC_API_KEY=
EMAIL_FROM=
EMAIL_REGION=
EMAIL_LINK_SECRET=
ALERTS_URL=
ALERTS_SECRET=
ALERTS_ACTION_SECRET=
