{
  "name": "tracetray-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    }
  },
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "check": "tsc --noEmit",
    "build": "expo export --platform android --output-dir dist",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@clerk/expo": "^4.13.0",
    "@expo-google-fonts/instrument-sans": "^0.4.2",
    "@tracetray/shared": "*",
    "expo": "~58.0.14",
    "expo-auth-session": "~58.0.13",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-font": "~58.0.8",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "^19.3.1",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "~6.0.3"
  }
}
