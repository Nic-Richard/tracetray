{
  "expo": {
    "name": "TraceTray",
    "slug": "tracetray",
    "scheme": "tracetray",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.tracetray.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.tracetray.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@clerk/expo",
      "expo-font",
      "expo-web-browser",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
