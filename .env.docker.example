# Copy to .env.docker for `docker compose up`. Use the Clerk *development* instance keys here,
# never the live ones: development keys work on localhost.
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_

# Stripe test mode key, or leave the placeholder while billing isn't being tested.
STRIPE_SECRET_KEY=sk_test_placeholder

# Optional. Leave empty to keep Ask switched off locally.
ANTHROPIC_API_KEY=
